# Google Sign-In (OAuth 2.0 Web Client ID)
# Client ID — публічний; додається в Vercel Environment Variables і локальний .env
# У Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web):
#   Authorized JavaScript origins:
#     https://spokiy-2026.vercel.app
#     http://127.0.0.1:3000
#     http://localhost:3000
GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com

# Supabase (обов'язково на Vercel)
# Project Settings → API → Project URL + secret key (service_role або sb_secret_...)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_..._or_eyJ...

# Telegram-бот
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_USERNAME=YourSpokiyBot
TELEGRAM_WEBHOOK_SECRET=random_secret_for_webhook_header

# Cron (захист /api/cron/rituals та setup-webhook)
CRON_SECRET=random_secret_for_cron_auth

# URL сайту для кнопок «Відкрити Спокій»
SITE_URL=https://your-app.vercel.app

# Опційно: локальний SQLite
# DB_PATH=./data/spokiy.db
# PORT=3000
