{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": { "maxDuration": 10 }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "spokiy-2026.vercel.app" }],
      "destination": "https://spokiy.me/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.spokiy.me" }],
      "destination": "https://spokiy.me/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/blog/yak-zaspokoitisya-za-5-hvilyn", "destination": "/blog/yak-zaspokoitisya-za-5-hvilyn.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/rituals",
      "schedule": "*/15 * * * *"
    }
  ]
}
